{
  "name": "mulmocast",
  "version": "2.18.0",
  "description": "",
  "type": "module",
  "main": "lib/index.node.js",
  "exports": {
    ".": {
      "types": "./lib/index.node.d.ts",
      "default": "./lib/index.node.js"
    },
    "./browser": {
      "types": "./lib/index.browser.d.ts",
      "default": "./lib/index.browser.js"
    },
    "./data": {
      "default": "./lib/data/index.js"
    },
    "./remotion": {
      "types": "./lib/index.remotion.d.ts",
      "default": "./lib/index.remotion.js"
    },
    "./remotion/guide": {
      "types": "./lib/index.remotion_guide.d.ts",
      "default": "./lib/index.remotion_guide.js"
    },
    "./assets/*": "./assets/*",
    "./scripts/*": "./scripts/*",
    "./tools/complete_script": {
      "types": "./lib/tools/complete_script.d.ts",
      "default": "./lib/tools/complete_script.js"
    }
  },
  "resolutions": {
    "minimatch": "^10.2.6",
    "tar": "7.5.22",
    "yauzl": "^3.4.0"
  },
  "bin": {
    "mulmo": "lib/cli/bin.js",
    "mulmocast": "lib/cli/bin.js",
    "mulmo-mcp": "lib/mcp/server.js"
  },
  "files": [
    "./lib",
    "./scripts/templates",
    "./scripts/test",
    "./assets/audio/silent60sec.mp3",
    "./assets/html/",
    "./assets/images/",
    "./assets/schemas/",
    "./assets/slide_themes/",
    "./assets/styles/",
    "./assets/templates/"
  ],
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "audio": "npx tsx ./src/cli/bin.ts audio",
    "translate": "npx tsx ./src/cli/bin.ts translate",
    "movie": "npx tsx ./src/cli/bin.ts movie",
    "images": "npx tsx ./src/cli/bin.ts images",
    "preprocess": "npx tsx ./src/cli/bin.ts preprocess",
    "pdf": "npx tsx ./src/cli/bin.ts pdf",
    "test": "rm -f scratchpad/test*.* && npx tsx ./src/cli/bin.ts audio scripts/test/test.json && npx tsx ./src/cli/bin.ts images scripts/test/test.json && npx tsx ./src/cli/bin.ts movie scripts/test/test.json",
    "ci_test": "cross-env NODE_ENV=test tsx --test --experimental-test-coverage ./test/*/test_*.ts",
    "lint": "eslint src test assets/html/js",
    "build": "tsc",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "build_test": "tsc && git checkout -- lib/*",
    "cli": "npx tsx ./src/cli/bin.ts",
    "scripting": "npx tsx ./src/cli/bin.ts tool scripting",
    "prompt": "npx tsx ./src/cli/bin.ts tool prompt",
    "schema": "npx tsx ./src/cli/bin.ts tool schema",
    "schema:write": "npx tsx ./src/cli/bin.ts tool schema > assets/schemas/mulmo_script.json",
    "markdown": "npx tsx ./src/cli/bin.ts markdown",
    "html": "npx tsx ./src/cli/bin.ts html",
    "story_to_script": "npx tsx ./src/cli/bin.ts tool story_to_script",
    "whisper": "npx tsx ./src/cli/bin.ts tool whisper",
    "latest": "yarn upgrade-interactive  --latest",
    "format": "prettier --write '{src,scripts,assets/templates,assets/styles,assets/html/js,draft,ideason,scripts_mag2,proto,test,batch,graphai,output,docs/scripts}/**/*.{ts,js,json,yaml}'",
    "deep_research": "npx tsx ./src/tools/deep_research.ts",
    "template": "npx tsx batch/template2tsobject.ts && yarn run format",
    "mcp_server": "npx tsx ./src/mcp/server.ts",
    "voice": "npx tsx batch/openai_sample.ts && yarn run movie  scripts/samples/openai_voice.json",
    "generate_action_docs": "npx tsx ./automation/generate_actions_docs/generate_action_docs.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/receptron/mulmocast-cli.git"
  },
  "author": "snakajima",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/receptron/mulmocast-cli/issues"
  },
  "homepage": "https://github.com/receptron/mulmocast-cli#readme",
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/genai": "^2.24.0",
    "@graphai/anthropic_agent": "^2.1.0",
    "@graphai/browserless_agent": "^2.0.4",
    "@graphai/gemini_agent": "^2.1.0",
    "@graphai/groq_agent": "^2.1.0",
    "@graphai/input_agents": "^1.0.2",
    "@graphai/openai_agent": "^2.1.0",
    "@graphai/stream_agent_filter": "^2.0.3",
    "@graphai/vanilla": "^2.0.12",
    "@graphai/vanilla_node_agents": "^2.0.4",
    "@inquirer/input": "^5.1.7",
    "@inquirer/select": "^5.2.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modernized/fluent-ffmpeg": "^1.0.3",
    "@mozilla/readability": "^0.6.0",
    "@mulmocast/deck": "^2.0.2",
    "@tavily/core": "^0.7.13",
    "archiver": "^8.0.0",
    "clipboardy": "^5.3.2",
    "dotenv": "^17.4.2",
    "graphai": "^2.0.18",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.1.1",
    "marked": "^18.1.0",
    "mulmocast-vision": "^1.0.12",
    "ora": "^9.4.1",
    "puppeteer": "^25.12.0",
    "replicate": "^1.4.0",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/fiber": "^9.8.1",
    "@receptron/test_utils": "^2.0.3",
    "@remotion/bundler": "^4.0.533",
    "@remotion/effects": "^4.0.533",
    "@remotion/layout-utils": "^4.0.533",
    "@remotion/motion-blur": "^4.0.533",
    "@remotion/noise": "^4.0.533",
    "@remotion/paths": "^4.0.533",
    "@remotion/renderer": "^4.0.533",
    "@remotion/shapes": "^4.0.533",
    "@remotion/three": "^4.0.533",
    "@remotion/transitions": "^4.0.533",
    "@types/archiver": "^8.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.4",
    "@types/yargs": "^17.0.35",
    "avatarscript": "^0.3.2",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.533",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.8.1",
    "@remotion/bundler": "^4.0.533",
