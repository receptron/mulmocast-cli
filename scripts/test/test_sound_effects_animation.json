    {
      "text": "とけいの はりが うごくよ。チク、タク、チク、タク……チーン！ いっしゅう したね。",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='h-full w-full flex items-center justify-center bg-teal-100'>",
          "  <svg id='clock' viewBox='0 0 200 200' class='w-96 h-96'>",
          "    <circle cx='100' cy='100' r='92' fill='white' stroke='#0f766e' stroke-width='10'/>",
          "    <g id='marks'></g>",
          "    <line id='hand' x1='100' y1='100' x2='100' y2='30' stroke='#e11d48' stroke-width='8' stroke-linecap='round'/>",
          "    <circle cx='100' cy='100' r='8' fill='#0f766e'/>",
          "  </svg>",
          "</div>"
        ],
        "script": [
          "const marks = document.getElementById('marks');",
          "for (let i = 0; i < 6; i++) {",
          "  const a = (i * 60 * Math.PI) / 180;",
          "  marks.innerHTML += `<circle cx='${100 + 74 * Math.sin(a)}' cy='${100 - 74 * Math.cos(a)}' r='6' fill='#14b8a6'/>`;",
          "}",
          "function render(frame, totalFrames, fps) {",
          "  const t = frame / fps;",
          "  // One step every 0.5 s: the tick at 0.5 ... 2.5 s, the full turn (and the chime) at 3.0 s.",
          "  const steps = Math.min(Math.floor(t / 0.5 + 1e-6), 6);",
          "  document.getElementById('hand').setAttribute('transform', `rotate(${steps * 60} 100 100)`);",
          "  const shaking = t >= 3.0 && t < 3.6;",
          "  const angle = shaking ? 8 * Math.sin((t - 3.0) * 40) * (1 - (t - 3.0) / 0.6) : 0;",
          "  document.getElementById('clock').style.transform = `rotate(${angle}deg)`;",
          "}"
        ],
        "animation": true
      },
      "soundEffects": [
        {
          "source": {
            "kind": "jinglescript",
            "score": {
              "format": "jinglescript/1",
              "title": "Clock turn",
