  "beats": [
    {
      "text": "こんにちは！ きょうは、いっしょに かずを かぞえてみよう！",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='h-full w-full flex items-center justify-center bg-gradient-to-b from-sky-300 to-sky-100 overflow-hidden'>",
          "  <h1 id='title' class='text-8xl font-black text-orange-500 drop-shadow-lg' style='transform:translateY(-500px)'>かぞえてみよう！</h1>",
          "</div>"
        ],
        "script": [
          "const seg = (t, a, b) => Math.max(0, Math.min(1, (t - a) / (b - a)));",
          "function render(frame, totalFrames, fps) {",
          "  const t = frame / fps;",
          "  // Falls from 0.3 s and lands at 0.8 s (the 'hit' cue of the jingle), then bounces back from a squash.",
          "  const y = -500 * (1 - Easing.easeIn(seg(t, 0.3, 0.8)));",
          "  const scale = t < 0.8 ? 1 : 1.25 - 0.25 * Easing.easeOut(seg(t, 0.8, 1.1));",
          "  document.getElementById('title').style.transform = `translateY(${y}px) scale(${scale})`;",
          "}"
        ],
        "animation": true
      },
      "soundEffects": [
        {
          "source": {
            "kind": "jinglescript",
            "score": {
              "format": "jinglescript/1",
              "title": "Title lands",
              "tempo": 120,
              "length": {
                "seconds": 3
              },
              "cues": {
                "hit": {
                  "seconds": 0.8
                }
              },
              "tracks": [
                {
                  "instrument": "whoosh",
                  "gain": -4,
                  "notes": [
