    {
      "text": "さいごの もんだい。ほしは いくつ でたかな？ そう、みっつ！ せいかい！ よくできました！",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='h-full w-full flex items-center justify-center bg-yellow-50'>",
          "  <div id='stamp' class='w-[420px] h-[420px] rounded-full border-[28px] border-red-500 flex items-center justify-center' style='opacity:0'>",
          "    <span class='text-8xl font-black text-red-500'>せいかい</span>",
          "  </div>",
          "</div>"
        ],
        "script": [
          "const seg = (t, a, b) => Math.max(0, Math.min(1, (t - a) / (b - a)));",
          "function render(frame, totalFrames, fps) {",
          "  const t = frame / fps;",
          "  // Comes down from 0.7 s and hits the paper at 1.0 s, with a small rebound.",
          "  const down = Easing.easeIn(seg(t, 0.7, 1.0));",
          "  const rebound = t < 1.0 ? 0 : t < 1.08 ? 0.08 * seg(t, 1.0, 1.08) : 0.08 * (1 - Easing.easeInOut(seg(t, 1.08, 1.25)));",
          "  const stamp = document.getElementById('stamp');",
          "  stamp.style.opacity = seg(t, 0.7, 0.8);",
          "  stamp.style.transform = `scale(${3 - 2 * down + rebound}) rotate(${-25 + 17 * down}deg)`;",
          "}"
        ],
        "animation": true
      },
      "soundEffects": [
