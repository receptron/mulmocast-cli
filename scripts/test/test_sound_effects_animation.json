                {
                  "instrument": "marimba",
                  "notes": [
                    {
                      "at": "hit",
                      "pitch": ["C3", "G3"],
                      "vel": 0.9
                    }
                  ]
                }
              ]
            }
          },
          "volume": 0.8
        }
