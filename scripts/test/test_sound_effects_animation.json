    {
      "text": "ほしが でてくるよ。ひとつ、ふたつ、みっつ！ ぜんぶで みっつ だね。",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='h-full w-full flex flex-col items-center justify-center bg-indigo-950'>",
          "  <div class='flex gap-24'>",
          "    <div class='flex flex-col items-center'>",
          "      <div id='star0' class='w-48 h-48' style='transform:scale(0)'><svg viewBox='0 0 100 100' class='w-full h-full'><polygon points='50,5 61,38 96,38 68,59 79,93 50,72 21,93 32,59 4,38 39,38' fill='#facc15' stroke='#f59e0b' stroke-width='4' stroke-linejoin='round'/></svg></div>",
          "      <div id='num0' class='text-7xl font-black text-white mt-6' style='opacity:0'>1</div>",
          "    </div>",
          "    <div class='flex flex-col items-center'>",
          "      <div id='star1' class='w-48 h-48' style='transform:scale(0)'><svg viewBox='0 0 100 100' class='w-full h-full'><polygon points='50,5 61,38 96,38 68,59 79,93 50,72 21,93 32,59 4,38 39,38' fill='#facc15' stroke='#f59e0b' stroke-width='4' stroke-linejoin='round'/></svg></div>",
          "      <div id='num1' class='text-7xl font-black text-white mt-6' style='opacity:0'>2</div>",
          "    </div>",
          "    <div class='flex flex-col items-center'>",
          "      <div id='star2' class='w-48 h-48' style='transform:scale(0)'><svg viewBox='0 0 100 100' class='w-full h-full'><polygon points='50,5 61,38 96,38 68,59 79,93 50,72 21,93 32,59 4,38 39,38' fill='#facc15' stroke='#f59e0b' stroke-width='4' stroke-linejoin='round'/></svg></div>",
          "      <div id='num2' class='text-7xl font-black text-white mt-6' style='opacity:0'>3</div>",
          "    </div>",
          "  </div>",
          "</div>"
        ],
        "script": [
          "const times = [0.8, 1.6, 2.4];",
          "const seg = (t, a, b) => Math.max(0, Math.min(1, (t - a) / (b - a)));",
          "function render(frame, totalFrames, fps) {",
          "  const t = frame / fps;",
          "  times.forEach((at, i) => {",
          "    // Pops out at its time (overshooting to 1.25), then settles to 1.",
          "    const scale = t < at ? 0 : t < at + 0.12 ? 1.25 * Easing.easeOut(seg(t, at, at + 0.12)) : 1.25 - 0.25 * Easing.easeInOut(seg(t, at + 0.12, at + 0.3));",
          "    document.getElementById(`star${i}`).style.transform = `scale(${scale})`;",
          "    const shown = Easing.easeOut(seg(t, at, at + 0.25));",
          "    const num = document.getElementById(`num${i}`);",
          "    num.style.opacity = shown;",
          "    num.style.transform = `translateY(${20 * (1 - shown)}px)`;",
          "  });",
          "}"
        ],
        "animation": true
      },
      "soundEffects": [
        {
          "source": {
            "kind": "jinglescript",
            "score": {
              "format": "jinglescript/1",
              "title": "Three pops",
              "tempo": 120,
