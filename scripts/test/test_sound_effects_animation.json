                      "vel": 0.85
                    },
                    {
                      "at": {
                        "seconds": 2.4
                      },
                      "pitch": "C7",
                      "vel": 0.85
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "text": "ボールが はねるよ。ぽーん、ぽーん、ぽーん。なんかい はねたかな？",
      "image": {
        "type": "html_tailwind",
        "html": [
          "<div class='h-full w-full relative bg-gradient-to-b from-amber-50 to-amber-100 overflow-hidden'>",
          "  <div class='absolute left-0 right-0 bottom-0 h-24 bg-green-500'></div>",
          "  <div id='ball' class='absolute w-32 h-32 rounded-full bg-gradient-to-br from-rose-400 to-red-600 shadow-xl' style='left:calc(50% - 64px); bottom:96px'></div>",
          "</div>"
        ],
        "script": [
          "const landings = [0.6, 1.2, 1.8];",
          "const floor = 96, peak = 520; // (not `top`: that is window.top)",
          "function render(frame, totalFrames, fps) {",
          "  const t = frame / fps;",
          "  let h = 0;",
          "  if (t < landings[0]) {",
          "    const u = t / landings[0];",
          "    h = peak * (1 - u * u); // falling from the top",
          "  } else {",
          "    for (let k = 1; k < landings.length; k++) {",
          "      if (t < landings[k]) {",
          "        const u = (t - landings[k - 1]) / (landings[k] - landings[k - 1]);",
          "        h = peak * Math.pow(0.5, k) * 4 * u * (1 - u); // smaller arc after each bounce",
          "        break;",
          "      }",
          "    }",
          "  }",
          "  const ball = document.getElementById('ball');",
          "  ball.style.bottom = `${floor + h}px`;",
          "  // Squash for a moment on each landing.",
          "  const squash = landings.some((l) => t >= l && t < l + 0.08);",
          "  ball.style.transform = squash ? 'scale(1.25, 0.75) translateY(10px)' : 'none';",
          "}"
        ],
        "animation": true
      },
      "soundEffects": [
        {
          "source": {
            "kind": "url",
            "url": "https://github.com/receptron/mulmocast-media/raw/refs/heads/main/soundeffects/opengameart/ezduzziteh-boings/bing_01.mp3"
